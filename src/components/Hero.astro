---
import { getManifoldRelease } from '../lib/manifold-release'
// Version and download URLs come from the app's latest release at build time.
const { version, armDmg, intelDmg } = await getManifoldRelease()
---
<header class="hero">
  <div class="container">
    <div class="wordmark">MANIFOLD</div>
    <div class="hero-rule"></div>
    <h1 class="hero-tagline">
      Every agent. Every repo.<br />
      <em>None of it leaves your infrastructure.</em>
    </h1>
    <p class="hero-lede">
      Manifold runs Claude Code, Codex, Gemini CLI, Copilot — and local models — across your
      repositories, in real terminals on isolated branches. Self-hosted end to end: your
      machines, your credentials, your policy. No per-seat licence, and no vendor holding
      your source.
    </p>
    <div class="hero-ctas">
      <a href={armDmg} class="btn-primary">Download for macOS (Apple Silicon)</a>
      <a href={intelDmg} class="hero-intel">Intel</a>
    </div>
    <p class="hero-meta">MIT licensed · self-hosted · no account · no telemetry · v{version}</p>
  </div>
</header>

<style>
  .hero {
    text-align: center;
    padding: var(--space-2xl) 0 var(--space-xl);
    background: radial-gradient(120% 70% at 50% -10%, var(--hero-glow) 0%, var(--canvas) 55%);
  }
  .wordmark {
    font-weight: 300;
    letter-spacing: 0.4em;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 1;
    color: var(--text-primary);
    padding-left: 0.4em;
  }
  .hero-rule { width: 56px; height: 1px; background: var(--accent-gold); margin: var(--space-lg) auto; }

  /* The display serif is the page's whole visual argument — it is what stops
     this reading like every other developer-tool landing page. */
  .hero-tagline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    /* Sized to the longer line ("None of it leaves your infrastructure.", 37ch)
       so the claim holds one line instead of wrapping to a third. */
    max-width: 38ch;
    margin: 0 auto;
  }
  .hero-tagline em { font-style: italic; color: var(--accent-text); }

  .hero-lede { font-size: 1.05rem; color: var(--text-secondary); max-width: 620px; margin: var(--space-lg) auto 0; }
  .hero-ctas { display: flex; gap: var(--space-md); align-items: center; justify-content: center; flex-wrap: wrap; margin-top: var(--space-xl); }
  .hero-meta { margin-top: var(--space-md); font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-muted); }
</style>
