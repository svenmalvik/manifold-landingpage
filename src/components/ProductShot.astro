---
// Real capture, taken on a throwaway profile registering only a fictional
// `checkout-service` repo — no internal project names. Cropped to exclude the
// terminal's bottom strip; nothing in the frame is retouched.
//
// What it actually shows: two agent tabs (Claude and Codex), the live Claude
// Code banner, the file tree, and a rendered README. The agents are idle, so the
// caption must not claim work in flight, and there is deliberately no
// running/waiting/done/error legend here — the four states are labelled in the
// worktree figure further down, where a real example backs them up.
const img = '/images/workspace.webp'
const width = 2200
const height = 672
---
<section class="shot">
  <div class="shot-frame metal-frame">
    <img
      src={img}
      alt="The Manifold workspace: a Claude Code agent and a Codex agent open as tabs over one repository, with the file tree and rendered README beside them"
      width={width}
      height={height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <p class="shot-caption">Two agents, one repository, one window — each on its own branch.</p>
</section>

<style>
  .shot { max-width: 1100px; margin: var(--space-2xl) auto 0; padding: 0 var(--space-xl); }
  .shot-frame img { width: 100%; height: auto; display: block; }


  .shot-caption {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: var(--space-md);
  }
</style>
