---
import Section from './Section.astro'
// The comparison section that contains no comparison. Whitespace does the work
// here. Resist adding anything. Release count verified 2026-08-10 via
// `gh release list --repo vippsas/manifold --limit 500 | wc -l`.
// "No server in the middle" was true when written and isn't any more. Manifold
// Server exists (in beta). It runs on the operator's own infrastructure, so the
// substance holds, but the line has to say *whose* server rather than none.
const absences = [
  'No per-seat licence.',
  'No account to create.',
  'No Pro tier, no upgrade path, no upsell.',
  'No service of ours in the middle.',
  'No telemetry.',
  "No lock-in. It's your git, your branches, your infrastructure.",
]
---
<Section id="receipt" eyebrow="The receipt">
  <Fragment slot="title">What you <em>don't</em> get.</Fragment>

  <ul class="absences">
    {absences.map((a) => <li>{a}</li>)}
  </ul>

  <p class="close">
    Free under the MIT licence, at any headcount. 168 releases since March.
    <a href="https://github.com/vippsas/manifold">Fork it</a> if we get it wrong.
  </p>
</Section>

<style>
  .absences {
    list-style: none;
    margin-top: var(--space-2xl);
    display: grid;
    gap: var(--space-lg);
  }
  .absences li {
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2vw, 1.15rem);
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .close {
    margin-top: var(--space-2xl);
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
