---
import '../styles/theme.css'
import '@fontsource/inter/300.css'
import '@fontsource/inter/400.css'
import '@fontsource/inter/500.css'
import '@fontsource/inter/600.css'
import '@fontsource/inter/700.css'
import '@fontsource/jetbrains-mono/400.css'
import '@fontsource/jetbrains-mono/700.css'
import '@fontsource/instrument-serif/400.css'
import '@fontsource/instrument-serif/400-italic.css'
import Navigation from '../components/Navigation.astro'
import Footer from '../components/Footer.astro'
import themes from '../data/themes-meta.json'

const themeIds = themes.map((t) => t.id)

interface Props {
  title?: string
  description?: string
}
const {
  title = 'Manifold — A full developer workspace for orchestrating AI agents',
  description = 'Run Claude Code, Codex, Gemini CLI, Copilot and local models side by side on one codebase — real terminals, isolated git branches, and nothing leaving your Mac.',
} = Astro.props
// JPEG rather than the on-page WebP: social crawlers are the one place where
// broad format support still matters more than bytes. Regenerate alongside the
// product shot with:
//   sips -s format jpeg -s formatOptions 80 -Z 1200 <source> --out public/images/og.jpg
const ogImage = 'https://manifold.no/images/og.jpg'
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline define:vars={{ themeIds }}>
    // Set the theme before first paint to avoid a flash: a previously saved
    // choice wins; otherwise default to Neon, matching the visitor's OS setting.
    ;(function () {
      try {
        var saved = localStorage.getItem('manifold-theme')
        var theme
        if (saved && themeIds.indexOf(saved) !== -1) {
          theme = saved
        } else {
          var light = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
          theme = light ? 'manifold-light' : 'manifold-dark'
        }
        document.documentElement.setAttribute('data-theme', theme)
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'manifold-dark')
      }
    })()
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://manifold.no" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1024 1024' width='1024' height='1024'><rect width='1024' height='1024' rx='192' ry='192' fill='%230A0A0A'/><defs><mask id='g'><rect width='1024' height='1024' fill='white'/><circle cx='410' cy='440' r='52' fill='black'/><circle cx='614' cy='440' r='52' fill='black'/><path d='M430 540Q512 610 594 540Q570 580 512 590Q454 580 430 540Z' fill='black'/></mask></defs><path mask='url(%23g)' fill='%23CCFF00' d='M512 180C340 180 260 310 260 440L260 700Q260 740 290 740Q320 710 350 740Q380 770 410 740Q440 710 470 740Q500 770 530 740Q560 710 590 740Q620 770 650 740Q680 710 710 740Q740 770 764 740L764 440C764 310 684 180 512 180Z'/></svg>" />
</head>
<body>
  <Navigation />
  <slot />
  <Footer />
</body>
</html>
